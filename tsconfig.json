{
    "include": [
        "./src/**/*.ts",
        "./test/**/*.ts",
        "./src/$core/*.ts",
        "./src/$wrap/*.ts"
    ],
    "exclude": [
        "./dist/**/*",
        "./externals/**/*",
        "./src/**/*.js",
        "./src/**/*.jsx"
    ],
    "compilerOptions": {
        "outDir": "./dist/",
        "paths": {
            "@fest-lib/*": [
                "../../shared/fest/*"
            ],
            "@fest-lib/cdnImport": [
                "../../cdnImport.mjs"
            ],
            "@fest-lib/dom": [
                "../dom.ts/src/index.ts"
            ],
            "@fest-lib/lure": [
                "../lur.e/src/index.ts"
            ],
            "@fest-lib/object": [
                "./src/index.ts"
            ],
            "@fest-lib/core": [
                "../core.ts/src/index.ts"
            ],
            "@fest-lib/fl-ui": [
                "./src/index.ts"
            ],
            "@fest-lib/ui": [
                "./src/index.ts"
            ],
            "@fest-lib/uniform": [
                "../uniform.ts/src/index.ts"
            ],
            "@fest-lib/theme": [
                "../theme.core/src/index.ts"
            ],
            "@fest-lib/polyfill/*": [
                "../../shared/fest/polyfill/*"
            ],
            "polyfill/*": [
                "../../shared/fest/polyfill/*"
            ]
        },
        "target": "ESNext",
        "module": "ESNext",
        "lib": [
            "ESNext",
            "DOM",
            "WebWorker"
        ],
        "esModuleInterop": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "allowJs": true,
        "allowArbitraryExtensions": true,
        "allowSyntheticDefaultImports": true,
        "allowUmdGlobalAccess": true,
        "allowUnreachableCode": true,
        "allowUnusedLabels": true,
        "noImplicitAny": false,
        "noImplicitThis": false,
        "declaration": true,
        "declarationMap": true,
        "inlineSources": true,
        "inlineSourceMap": true,
        "typeRoots": [
            "plugins/global.d.ts"
        ],
        "experimentalDecorators": true,
        "noEmit": true,
        "noEmitOnError": true,
        "noEmitHelpers": true
    },
    "compileOnSave": false
}
